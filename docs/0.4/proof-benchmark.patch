diff --git a/crates/statechronicle-proof/tests/verification_pipeline.rs b/crates/statechronicle-proof/tests/verification_pipeline.rs
index 2882ffa..1b010fc 100644
--- a/crates/statechronicle-proof/tests/verification_pipeline.rs
+++ b/crates/statechronicle-proof/tests/verification_pipeline.rs
@@ -1286,0 +1287,193 @@ async fn trade_verifier_rejects_state_proof_under_a_different_leg_tenant() {
+#[tokio::test]
+/// Re-run from the repository root with the same sampling counts and CPU pin:
+/// `taskset -c 4 env CARGO_BUILD_JOBS=1 CARGO_TARGET_DIR=/workspace/work/target-proof-bench SC_PROOF_BENCH_SAMPLES=1000 SC_PROOF_BENCH_WARMUP=100 cargo +1.100.0 test --release --locked -p statechronicle-proof --test verification_pipeline benchmark_v1_historical_and_current_claim_verification -- --ignored --nocapture`
+#[ignore = "manual release latency benchmark"]
+async fn benchmark_v1_historical_and_current_claim_verification() {
+    use std::{future::Future, hint::black_box, time::Instant};
+
+    use statechronicle_commit::sign_v1::sign_commit_v1;
+    use statechronicle_core::{
+        signature_operation::SignatureContext,
+        signature_provider::{Ed25519Signer, Ed25519Verifier, KeySetId, SignaturePurpose, Signer},
+    };
+    use statechronicle_domain::proof::{CommitRefV1, ResourceStateProofV1};
+    use statechronicle_ports::{
+        commit_store::{CommitReadFuture, CommitReaderV1},
+        key_registry::KeyRegistryError,
+        signature_policy::{
+            ResolvedSignaturePolicy, ResolvedSignatureV1, SignatureAuthority, SignaturePolicy,
+            SignaturePolicyQuery,
+        },
+    };
+    use statechronicle_proof::claim::{
+        ClaimProofV1, ClaimVerifierV1, ExpectedClaim, VerificationPoint,
+    };
+
+    struct V1Reader {
+        tenant: TenantId,
+        head: CanonicalHead,
+        record: Vec<u8>,
+    }
+    impl CommitReaderV1 for V1Reader {
+        fn read_commit_record_v1<'read>(
+            &'read self,
+            tenant: &'read TenantId,
+            commit: &'read CommitId,
+        ) -> CommitReadFuture<'read, Option<Vec<u8>>> {
+            let record = (tenant == &self.tenant && commit == &self.head.commit_id)
+                .then(|| self.record.clone());
+            Box::pin(async move { Ok(record) })
+        }
+
+        fn read_canonical_head_v1<'read>(
+            &'read self,
+            tenant: &'read TenantId,
+        ) -> CommitReadFuture<'read, Option<CanonicalHead>> {
+            let head = (tenant == &self.tenant).then(|| self.head.clone());
+            Box::pin(async move { Ok(head) })
+        }
+    }
+
+    struct Policy(Arc<Ed25519Verifier>, KeySetId);
+    #[async_trait]
+    impl SignaturePolicy for Policy {
+        async fn resolve(
+            &self,
+            query: SignaturePolicyQuery<'_>,
+        ) -> Result<ResolvedSignaturePolicy, KeyRegistryError> {
+            assert!(matches!(
+                query.authority,
+                SignatureAuthority::TenantCommit { .. }
+            ));
+            Ok(ResolvedSignaturePolicy::V1(
+                ResolvedSignatureV1::new(self.0.clone(), self.1, 64).expect("fixed Ed25519 policy"),
+            ))
+        }
+    }
+
+    async fn sample<F, Fut>(name: &str, warmup: usize, count: usize, mut operation: F)
+    where
+        F: FnMut() -> Fut,
+        Fut: Future<Output = Result<(), ProofError>>,
+    {
+        let mut times = Vec::with_capacity(count);
+        for index in 0..warmup + count {
+            let start = Instant::now();
+            black_box(operation().await.expect("proof verification"));
+            let elapsed = start.elapsed().as_nanos();
+            if index >= warmup {
+                times.push(elapsed);
+            }
+        }
+        times.sort_unstable();
+        let percentile = |percent: usize| {
+            let rank = times.len().saturating_mul(percent).div_ceil(100);
+            times[rank.saturating_sub(1)]
+        };
+        println!(
+            "{name},count={count},warmup={warmup},p50_ns={},p95_ns={},p99_ns={}",
+            percentile(50),
+            percentile(95),
+            percentile(99),
+        );
+    }
+
+    let count = std::env::var("SC_PROOF_BENCH_SAMPLES")
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .filter(|value| *value > 0)
+        .unwrap_or(1000usize);
+    let warmup = std::env::var("SC_PROOF_BENCH_WARMUP")
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .filter(|value| *value > 0)
+        .unwrap_or(100usize);
+
+    // Reuse the existing one-leaf sparse-Merkle fixture and proof builder from
+    // this file; replace only its legacy signed-commit reference with v1 bytes.
+    let fixture = fixture();
+    let legacy_proof = build_proof(&fixture);
+    let signing_key = fixed_key();
+    let key_set_id = KeySetId([0x51; 32]);
+    let purpose = SignaturePurpose::TenantCommit;
+    let signer = Ed25519Signer::new(&signing_key, key_set_id, purpose);
+    let context = SignatureContext {
+        suite: signer.suite(),
+        key_set_id: &key_set_id,
+        purpose,
+        body_schema: statechronicle_domain::commit::COMMIT_SCHEMA,
+        signature_len: 64,
+    };
+    let record = sign_commit_v1(&fixture.signed.body, &context, &signer)
+        .expect("v1 fixture commit signature");
+    let signed_proof = ResourceStateProofV1::new(
+        legacy_proof.tenant_id.clone(),
+        legacy_proof.resource_id.clone(),
+        legacy_proof.claimed_state.clone(),
+        CommitRefV1 {
+            commit_id: fixture.signed.body.commit_id.clone(),
+            sequence: fixture.signed.body.sequence,
+            state_root: fixture.signed.body.next_state_root.clone(),
+            signed_commit_record: record.clone(),
+        },
+        legacy_proof.state_inclusion_proof.clone(),
+        legacy_proof.latest_event.clone(),
+        legacy_proof.authority.clone(),
+    );
+    let verifier = Ed25519Verifier::new(&signing_key.verifying_key(), key_set_id, purpose);
+    let policy = Policy(Arc::new(verifier), key_set_id);
+    let authority = fixture.signed.body.executor.clone();
+    let head = head(&fixture.signed);
+    let service = ClaimVerifierV1::new(Box::new(V1Reader {
+        tenant: tenant(),
+        head,
+        record: record.clone(),
+    }));
+    let expected = ExpectedClaim::ownership(tenant(), resource(), SubjectId(owner()));
+    let claim = ClaimProofV1::State(&signed_proof);
+    let now = fixture.signed.body.created_at;
+
+    // Preflight each path outside the measured samples and assert result scopes.
+    assert_eq!(
+        service
+            .verify_historical_v1(claim, &expected, &commit_id(), &authority, &policy, now,)
+            .await
+            .unwrap()
+            .point(),
+        VerificationPoint::Historical
+    );
+    assert_eq!(
+        service
+            .verify_current_v1(claim, &expected, &authority, &policy, now)
+            .await
+            .unwrap()
+            .point(),
+        VerificationPoint::Current
+    );
+
+    println!(
+        "fixture=verification_pipeline::fixture/build_proof,tenant={},commit={},body_bytes={},envelope_bytes={},state_proof_bcs_bytes={},samples={count},warmup={warmup},arch={},os={}",
+        tenant().0,
+        commit_id().0,
+        bcs::to_bytes(&fixture.signed.body).unwrap().len(),
+        record.len(),
+        bcs::to_bytes(&signed_proof).unwrap().len(),
+        std::env::consts::ARCH,
+        std::env::consts::OS,
+    );
+    sample("historical_v1_ed25519", warmup, count, || async {
+        service
+            .verify_historical_v1(claim, &expected, &commit_id(), &authority, &policy, now)
+            .await
+            .map(|_| ())
+    })
+    .await;
+    sample("current_v1_ed25519", warmup, count, || async {
+        service
+            .verify_current_v1(claim, &expected, &authority, &policy, now)
+            .await
+            .map(|_| ())
+    })
+    .await;
+}
+
