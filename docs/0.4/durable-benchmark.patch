@@ -726,0 +727,17 @@ async fn v1_batch_recovers_the_full_exact_group_after_lost_ack() {
+    if std::env::var_os("STATECHRONICLE_DURABLE_BENCH").is_some() {
+        const SAMPLES: usize = 31;
+        let mut commit_ns = Vec::with_capacity(SAMPLES);
+        let mut recovery_ns = Vec::with_capacity(SAMPLES);
+        for _ in 0..SAMPLES {
+            let ledger = MemoryLedger::default();
+            let start = std::time::Instant::now();
+            signed.commit(&ledger, &Allow, &trust).await.unwrap();
+            commit_ns.push(start.elapsed().as_nanos());
+
+            let start = std::time::Instant::now();
+            signed.recover(&ledger, &Allow, &trust).await.unwrap();
+            recovery_ns.push(start.elapsed().as_nanos());
+        }
+        common::report_benchmark("v1_batch_2_events_commit", &commit_ns);
+        common::report_benchmark("v1_batch_2_events_exact_recovery", &recovery_ns);
+    }
