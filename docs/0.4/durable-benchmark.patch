diff --git a/crates/statechronicle/tests/common/mod.rs b/crates/statechronicle/tests/common/mod.rs
index 1d09c74..0311f65 100644
--- a/crates/statechronicle/tests/common/mod.rs
+++ b/crates/statechronicle/tests/common/mod.rs
@@ -4,0 +5,22 @@ pub use harness::*;
+
+/// Emits reproducible raw latency samples and nearest-rank percentiles for
+/// opt-in release measurements in the durable integration fixtures.
+pub fn report_benchmark(name: &str, samples: &[u128]) {
+    let mut sorted = samples.to_vec();
+    sorted.sort_unstable();
+    let percentile = |rank: usize| {
+        let index = sorted
+            .len()
+            .saturating_mul(rank)
+            .div_ceil(100)
+            .saturating_sub(1);
+        sorted.get(index).copied().unwrap_or_default()
+    };
+    println!(
+        "BENCH,{name},n={},p50_ns={},p95_ns={},p99_ns={},raw_ns={samples:?}",
+        sorted.len(),
+        percentile(50),
+        percentile(95),
+        percentile(99),
+    );
+}
